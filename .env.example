# ShoulderCut — copy to .env and fill in. Never use VITE_ for API keys.
# Muse Code supervisor (optional if muse is already logged in).
MUSE_API_KEY=
# Meta Model API: SAM masks, realtime commands, and caption transcription.
MODEL_API_KEY=
# Optional hosted generative-video provider.
FAL_KEY=
# GEN_PROVIDER=stub
# COMFY_URL=http://127.0.0.1:8188
# MUSE_BIN=
# Explicit editor model: independent of personal Muse CLI settings.
MUSE_EDITOR_MODEL=muse-wonder-1.0

# Realtime voice output; configure ElevenLabs or Gemini, or both.
ELEVEN_API_KEY=
# Set this to the cloned voice id to use the same voice as etiennelescot.fr.
TTS_VOICE_FR=
TTS_MODEL=eleven_flash_v2_5
# Optional Gemini / Google AI Studio fallback, or primary if ElevenLabs is absent.
GOOGLE_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
# Small conversation model; editing continues in the existing Muse supervisor.
VOICE_DIALOGUE_MODEL=muse-spark-1.2
# Optional path to an existing env file containing the voice credentials.
SHOULDERCUT_VOICE_ENV=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Local dev-server executable; not required with LiveKit Cloud.
LIVEKIT_SERVER=E:\livekit\livekit-server.exe
