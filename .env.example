# ShoulderCut — copy to .env and fill in. .env is gitignored; this file is not.
#
# Two keys are required, one is optional. Nothing else is needed: the agent,
# the speech-to-text and the segmentation all run on Meta models, and the
# spoken replies use the browser's own speech synthesis, which costs nothing
# and needs no account.

# Muse Code CLI — the editing Supervisor. The bridge starts `muse exec` and
# gives it the shouldercut-fx MCP server as its whole tool surface.
# Not needed if `muse` is already logged in on this machine.
MUSE_API_KEY=

# Meta Model API — SAM 3.1 object masks AND Muse Voice Transcribe, which is
# what turns push-to-talk into text and clip audio into captions. One key
# serves both. https://api.meta.ai/v1
MODEL_API_KEY=

# fal.ai — OPTIONAL. Only the hosted generative-video backends of
# `edit_segment` (vace, wan-animate, kling-o3, recast). Leave empty to use
# the local ComfyUI backends, or GEN_PROVIDER=stub to run the whole
# generative path offline at no cost.
FAL_KEY=

# --- optional, all have working defaults ---

# Where the generative-video jobs go: stub (offline, free), fal (hosted,
# needs FAL_KEY), comfy (local ComfyUI, free).
# GEN_PROVIDER=stub

# Local ComfyUI, for the scail / scail-animate / vace-local backends and for
# regenerating the mascot with tools/make-mascot.py.
# COMFY_URL=http://127.0.0.1:8188

# Override the Muse Code binary if it is not in the usual install directory.
# MUSE_BIN=
