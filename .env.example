# ShoulderCut — copy to .env and fill in what you need.
#
#   cp .env.example .env
#
# Two keys get you a working editor you can type at. Everything below that
# is additive: a missing key removes a capability, it never breaks the app.
# No key is ever sent to the browser — there is deliberately no VITE_
# variable in this project, and the browser's only credential is a
# short-lived LiveKit token the server mints for it.


# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — Meta Model API
# ─────────────────────────────────────────────────────────────────────────
# One key, four distinct Meta services. This is the spine of the editor:
#
#   SAM 3.1          Segments and tracks a subject through a passage from a
#                    plain noun phrase ("the red car"). The mask it returns
#                    is what lets an effect or a replacement apply to the
#                    subject and leave the rest of the frame untouched.
#                    → server/sam.ts
#
#   Muse Wonder      The editor itself. Reads your instruction, decides
#                    which tools to call, and writes the WGSL for any
#                    visual effect from scratch — there is no effects
#                    catalogue, every effect is code the model authors.
#                    → server/muse-runner.ts
#
#   Muse Spark       The conversation. Small and fast, so the mascot can
#                    answer while a long edit is still running.
#                    → server/conversation.ts, voice/dialogue.py
#
#   Meta ASR         Speech to text for captions, and for the recorded
#                    single-instruction fallback.
#                    → server/transcribe.ts
#
# Get one at https://developers.meta.ai — the hackathon's $150 of credit
# applies here.
MODEL_API_KEY=

# The Muse Code CLI that runs the editing agent. Not needed if you have
# already run `muse login` on this machine.
#   https://developers.meta.ai
MUSE_API_KEY=

# Pinned so the editor does not follow your personal Muse CLI settings.
MUSE_EDITOR_MODEL=muse-wonder-1.0
VOICE_DIALOGUE_MODEL=muse-spark-1.2
# MUSE_BIN=


# ─────────────────────────────────────────────────────────────────────────
# GENERATION — pick a home, or both
# ─────────────────────────────────────────────────────────────────────────
# Replacing a subject, inpainting over a mask, transferring motion: this is
# the expensive half, and it runs either on someone else's GPU or on yours.
# The editor picks between them by what is reachable, so configuring both
# means hosted is simply the fallback when your ComfyUI is off.

# Hosted, no GPU needed. Measured cost of one full pass over three clips:
# vace and wan-animate $0.61, kling-o3 $2.55, recast $4.56.
#   https://fal.ai/dashboard/keys
FAL_KEY=

# Local, free, your GPU. Any reachable ComfyUI: on this machine, in the
# `comfy` compose profile, or a serverless deployment somewhere else.
# From inside a container, the host is host.docker.internal.
# COMFY_URL=http://127.0.0.1:8188
# COMFY_DIR=E:\ComfyUI
#
# For the comfy compose profile: where your weights already live. They are
# tens of gigabytes and belong in a volume, never in an image.
# COMFY_MODELS_DIR=E:\ComfyUI\models

# Prepares every provider input for real and submits nothing. How the
# dogfood harness stays free.
# GEN_DRY_RUN=1
# GEN_PROVIDER=stub


# ─────────────────────────────────────────────────────────────────────────
# VOICE — optional
# ─────────────────────────────────────────────────────────────────────────
# Without any of this the editor still works; you type instead of talking.

# Transport for the realtime session. `docker compose --profile voice up`
# runs a dev server for you; otherwise a LiveKit Cloud project.
#   https://cloud.livekit.io  → Settings → Keys
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only to run a local LiveKit binary outside Docker:
# LIVEKIT_SERVER=

# The mascot's voice.
#   https://elevenlabs.io  → Profile → API key
ELEVEN_API_KEY=
TTS_MODEL=eleven_flash_v2_5
# A cloned voice id, if you have one.
TTS_VOICE_FR=

# Fallback when ElevenLabs is out of quota, or the primary voice if you
# configure no ElevenLabs key at all.
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# Point the voice worker at an env file of its own, if you keep one.
# SHOULDERCUT_VOICE_ENV=


# ─────────────────────────────────────────────────────────────────────────
# REMOTE ACCESS — optional, see docs/remote-access.md
# ─────────────────────────────────────────────────────────────────────────
# Unset, there is no gate and the editor answers on loopback only, which is
# right for your own machine. Set it and every route demands this key, the
# server answers on every interface, and it is safe to put behind a tunnel.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# SHOULDERCUT_ACCESS_KEY=

# Bind to one address instead of all of them. The compose file sets 0.0.0.0
# because 127.0.0.1 inside a container is the container.
# SHOULDERCUT_HOST=

# A real certificate turns on HTTPS, which a remote browser needs: without
# a secure context it loses WebCodecs, WebGPU and the microphone.
# SHOULDERCUT_TLS_CERT=.certs/cert.pem
# SHOULDERCUT_TLS_KEY=.certs/key.pem

# Where the local tools reach the editor. Only needed if it is not on
# http://127.0.0.1:5173 — the compose file sets it for the voice worker.
# SHOULDERCUT_BRIDGE=


# ─────────────────────────────────────────────────────────────────────────
# MODEL CACHES — keep weights off the system drive
# ─────────────────────────────────────────────────────────────────────────
# HF_HOME=E:\ai-cache\huggingface
# HF_HUB_CACHE=E:\ai-cache\huggingface\hub
# TORCH_HOME=E:\ai-cache\torch
# UV_CACHE_DIR=E:\ai-cache\uv
